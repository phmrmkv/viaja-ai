---
// Crédito "Desenvolvido por PHMR Tech Solutions" com o logo animado da PHMR.
// Copiado do portfólio (phmr.com.br): os 4 blocos do símbolo se montam quando o
// rodapé aparece na tela e de novo sempre que ele volta; no hover se afastam 2 px.
// Sem JS ou com movimento reduzido: logo parado (só um fade com movimento reduzido).
//
// Props:
//   fundo: 'claro' | 'escuro' | 'tema'
//     'claro'  = o rodapé é claro nos dois temas  -> logo de cores escuras
//     'escuro' = o rodapé é escuro nos dois temas -> logo de cores claras
//     'tema'   = o rodapé acompanha o tema         -> troca pelo [data-theme]
//   cor: cor do texto "Desenvolvido por" (padrão: herda)
import logoEscuroRaw from '../assets/phmr/logo-horizontal.svg?raw';
import logoClaroRaw from '../assets/phmr/logo-horizontal-claro.svg?raw';

interface Props {
  fundo?: 'claro' | 'escuro' | 'tema';
}
const { fundo = 'tema' } = Astro.props;

function preparar(raw: string, classe: string) {
  let n = 0;
  return raw
    .replace('<svg ', `<svg class="phmr-svg ${classe}" aria-hidden="true" focusable="false" `)
    .replace(/<path /g, (m) => (n < 4 ? `<path class="phmr-bloco phmr-bloco-${++n}" ` : m));
}
const paraFundoClaro = preparar(logoEscuroRaw, 'phmr-para-claro');
const paraFundoEscuro = preparar(logoClaroRaw, 'phmr-para-escuro');
---

<a
  href="https://phmr.com.br/"
  target="_blank"
  rel="noopener"
  class="phmr-credito"
  data-fundo={fundo}
>
  <span class="phmr-texto">Desenvolvido por</span>
  <span class="phmr-logo" data-phmr-ao-ver>
    {fundo !== 'escuro' && <Fragment set:html={paraFundoClaro} />}
    {fundo !== 'claro' && <Fragment set:html={paraFundoEscuro} />}
  </span>
  <span class="phmr-sr">PHMR Tech Solutions (abre em nova aba)</span>
</a>

<style is:global>
  .phmr-credito {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
    border-radius: 0.375rem;
  }
  .phmr-credito:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .phmr-texto { font-size: 0.875rem; }
  .phmr-credito:hover .phmr-texto { text-decoration: underline; text-underline-offset: 3px; }
  .phmr-logo { display: inline-flex; }
  .phmr-svg { display: block; height: 1.75rem; width: auto; }
  .phmr-sr {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
  /* Versão do logo conforme o fundo */
  .phmr-credito[data-fundo='tema'] .phmr-para-escuro { display: none; }
  [data-theme='dark'] .phmr-credito[data-fundo='tema'] .phmr-para-claro { display: none; }
  [data-theme='dark'] .phmr-credito[data-fundo='tema'] .phmr-para-escuro { display: block; }

  /* Montagem dos 4 blocos (mesma coreografia do portfólio) */
  .phmr-bloco { transition: translate 350ms cubic-bezier(0.22, 1, 0.36, 1); }
  @media (prefers-reduced-motion: no-preference) {
    .js .phmr-logo.phmr-montar .phmr-bloco {
      transform-box: fill-box;
      animation: phmr-bloco-entra 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .js .phmr-logo .phmr-bloco-1 { --phmr-de: translateX(-45%); animation-delay: 200ms; }
    .js .phmr-logo .phmr-bloco-2 { --phmr-de: translateY(-45%); animation-delay: 280ms; }
    .js .phmr-logo .phmr-bloco-3 { --phmr-de: translateY(45%); animation-delay: 360ms; }
    .js .phmr-logo .phmr-bloco-4 { --phmr-de: translateX(45%); animation-delay: 440ms; }
    .js .phmr-logo:not(.phmr-montar) .phmr-bloco { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .js .phmr-logo.phmr-montar .phmr-bloco { animation: phmr-fade 400ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  }
  @keyframes phmr-bloco-entra { from { opacity: 0; transform: var(--phmr-de, none); } }
  @keyframes phmr-fade { from { opacity: 0; } }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .phmr-credito:hover .phmr-bloco-1 { translate: -2px -2px; }
    .phmr-credito:hover .phmr-bloco-2 { translate: 2px -2px; }
    .phmr-credito:hover .phmr-bloco-3 { translate: -2px 2px; }
    .phmr-credito:hover .phmr-bloco-4 { translate: 2px 2px; }
  }
</style>

<script is:inline>
  // Monta o logo quando 60% dele aparece; desmonta quando sai, para montar de novo ao voltar.
  (function () {
    var logos = document.querySelectorAll('[data-phmr-ao-ver]');
    if (!('IntersectionObserver' in window)) {
      logos.forEach(function (el) { el.classList.add('phmr-montar'); });
      return;
    }
    var io = new IntersectionObserver(function (entradas) {
      entradas.forEach(function (e) {
        if (e.intersectionRatio >= 0.6) e.target.classList.add('phmr-montar');
        else if (!e.isIntersecting) e.target.classList.remove('phmr-montar');
      });
    }, { threshold: [0, 0.6] });
    logos.forEach(function (el) { io.observe(el); });
  })();
</script>
