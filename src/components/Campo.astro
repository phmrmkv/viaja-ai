---
/**
 * Campo de formulário com rótulo visível e mensagem de erro (preenchida por src/scripts/formularios.ts).
 * A validação é feita pelo script (o formulário usa novalidate); sem JS valem os atributos nativos (required etc.).
 */
interface Props {
  id: string;
  name?: string;
  rotulo: string;
  /** Trecho usado na mensagem de erro, ex.: "o nome" -> "Preencha o nome." */
  erroDe?: string;
  tipo?: 'text' | 'email' | 'password' | 'textarea' | 'select' | 'tel';
  regra?: 'email' | 'cpf' | 'cep' | 'cartao' | 'cvv' | 'senha' | 'nome';
  placeholder?: string;
  autocomplete?: string;
  inputmode?: 'numeric' | 'text' | 'email' | 'tel';
  opcoes?: string[];
  /** Texto da primeira opção (value vazio) do select */
  opcaoVazia?: string;
  linhas?: number;
  maxlength?: number;
  form?: string;
  class?: string;
  obrigatorio?: boolean;
  dica?: string;
}

const {
  id,
  name = id,
  rotulo,
  erroDe = rotulo.toLowerCase(),
  tipo = 'text',
  regra,
  placeholder,
  autocomplete,
  inputmode,
  opcoes = [],
  opcaoVazia,
  linhas = 5,
  maxlength,
  form,
  class: classe,
  obrigatorio = true,
  dica,
} = Astro.props;
const idErro = `${id}-erro`;
const idDica = dica ? `${id}-dica` : undefined;
const comum = {
  id,
  name,
  required: obrigatorio,
  'data-erro-de': erroDe,
  'data-regra': regra,
  'data-dica-id': idDica,
  'aria-describedby': [idDica, idErro].filter(Boolean).join(' '),
  autocomplete,
  form,
  class: 'campo-entrada',
};
---

<div class={classe}>
  <label for={id} class="campo-rotulo">{rotulo}</label>
  {
    tipo === 'textarea' ? (
      <textarea {...comum} rows={linhas} placeholder={placeholder} maxlength={maxlength} />
    ) : tipo === 'select' ? (
      <select {...comum} data-tipo="selecao">
        <option value="">{opcaoVazia ?? 'Selecione'}</option>
        {opcoes.map((o) => (
          <option value={o}>{o}</option>
        ))}
      </select>
    ) : (
      <input {...comum} type={tipo} placeholder={placeholder} inputmode={inputmode} maxlength={maxlength} />
    )
  }
  {dica && <p id={idDica} class="mt-1 text-sm text-muted-foreground">{dica}</p>}
  <p id={idErro} class="mensagem-erro" data-visivel="false"></p>
</div>
