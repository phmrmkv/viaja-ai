---
// Ícones originais do Caravan (img/icones/*.svg) embutidos, para herdar a cor do tema.
const icones = import.meta.glob('/src/assets/icones/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;

interface Props {
  icone: string;
  titulo: string;
  texto: string;
}
const { icone, titulo, texto } = Astro.props;
const bruto = icones[`/src/assets/icones/${icone}.svg`] ?? '';
const svg = bruto.replace(/<svg /, '<svg fill="currentColor" aria-hidden="true" focusable="false" class="h-full w-auto" ');
---

<div class="vantagem text-center">
  <div class="mx-auto flex h-24 items-center justify-center text-icone" set:html={svg} />
  <h3 class="mt-4 text-xl font-semibold">{titulo}</h3>
  <p class="mx-auto mt-2 max-w-xs text-muted-foreground">{texto}</p>
</div>
