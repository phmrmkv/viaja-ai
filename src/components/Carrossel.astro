---
import { Picture } from 'astro:assets';
import california from '@/assets/california.jpg';
import paris from '@/assets/paris.jpg';
import dublin from '@/assets/dublin.jpg';

const slides = [
  { img: california, nome: 'California', alt: 'Enseada de águas turquesa entre rochas, na costa da Califórnia' },
  { img: paris, nome: 'Paris', alt: 'Ponte sobre o Rio Sena ao pôr do sol, em Paris' },
  { img: dublin, nome: 'Dublin', alt: 'Colinas verdes e uma estrada sinuosa na paisagem irlandesa' },
];
---

<section class="carrossel" aria-roledescription="carrossel" aria-label="Destinos da Caravan" data-carrossel>
  <div class="carrossel-palco">
    <div class="carrossel-slides" data-slides aria-live="off">
      {
        slides.map((s, i) => (
          <div
            class="carrossel-slide"
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} de ${slides.length}: ${s.nome}`}
            data-ativo={i === 0 ? 'true' : 'false'}>
            <Picture
              src={s.img}
              alt={s.alt}
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              widths={[480, 800, 1200]}
              sizes="(min-width: 1024px) 58vw, 100vw"
              quality={70}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
              decoding={i === 0 ? 'sync' : 'async'}
              class="block h-full w-full object-cover"
              pictureAttributes={{ class: 'block h-full w-full' }}
            />
            <p class="absolute bottom-16 left-4 rounded-lg bg-black/60 px-4 py-1.5 text-2xl font-semibold text-white sm:left-6 sm:text-3xl">
              {s.nome}
            </p>
          </div>
        ))
      }
    </div>

    <div class="js-so absolute inset-x-0 bottom-0 flex items-center justify-between gap-2 px-2 pb-2 sm:px-4">
      <div class="flex items-center gap-2">
        <button type="button" class="carrossel-botao" data-anterior aria-label="Slide anterior">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m15 18-6-6 6-6"></path></svg>
        </button>
        <button type="button" class="carrossel-botao" data-proximo aria-label="Próximo slide">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6"></path></svg>
        </button>
      </div>
      <div class="flex items-center" role="group" aria-label="Escolher destino">
        {
          slides.map((s, i) => (
            <button type="button" class="carrossel-ponto" data-ponto={i} aria-label={`Ver ${s.nome}`} aria-current={i === 0 ? 'true' : undefined}></button>
          ))
        }
      </div>
      <button type="button" class="carrossel-botao carrossel-pausa" data-pausa data-estado="tocando" aria-label="Pausar rotação automática">
        <svg class="icone-pausa" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><rect x="6" y="5" width="4" height="14" rx="1"></rect><rect x="14" y="5" width="4" height="14" rx="1"></rect></svg>
        <svg class="icone-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"></path></svg>
      </button>
    </div>
  </div>
</section>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-carrossel]');
  if (raiz) {
    const slides = [...raiz.querySelectorAll<HTMLElement>('.carrossel-slide')];
    const pontos = [...raiz.querySelectorAll<HTMLButtonElement>('[data-ponto]')];
    const pausa = raiz.querySelector<HTMLButtonElement>('[data-pausa]')!;
    const lista = raiz.querySelector<HTMLElement>('[data-slides]')!;
    const intervalo = 6000;
    const reduzido = window.matchMedia('(prefers-reduced-motion: reduce)');

    let atual = 0;
    // Rotação automática só se a pessoa não pediu menos movimento; pode pausar a qualquer momento.
    let tocando = !reduzido.matches;
    let sobre = false; // ponteiro ou foco dentro do carrossel
    let timer: number | undefined;

    const mostrar = (i: number) => {
      atual = (i + slides.length) % slides.length;
      slides.forEach((s, n) => {
        const ativo = n === atual;
        s.dataset.ativo = String(ativo);
        s.toggleAttribute('inert', !ativo);
        s.setAttribute('aria-hidden', String(!ativo));
      });
      pontos.forEach((p, n) => (n === atual ? p.setAttribute('aria-current', 'true') : p.removeAttribute('aria-current')));
    };

    const agendar = () => {
      window.clearTimeout(timer);
      if (tocando && !sobre && !document.hidden) timer = window.setTimeout(() => { mostrar(atual + 1); agendar(); }, intervalo);
    };

    const atualizarPausa = () => {
      pausa.dataset.estado = tocando ? 'tocando' : 'parado';
      pausa.setAttribute('aria-label', tocando ? 'Pausar rotação automática' : 'Iniciar rotação automática');
      // Anuncia a troca de slide só quando não é automática
      lista.setAttribute('aria-live', tocando ? 'off' : 'polite');
      agendar();
    };

    raiz.querySelector('[data-anterior]')?.addEventListener('click', () => { mostrar(atual - 1); agendar(); });
    raiz.querySelector('[data-proximo]')?.addEventListener('click', () => { mostrar(atual + 1); agendar(); });
    pontos.forEach((p, n) => p.addEventListener('click', () => { mostrar(n); agendar(); }));
    pausa.addEventListener('click', () => { tocando = !tocando; atualizarPausa(); });

    raiz.addEventListener('pointerenter', () => { sobre = true; agendar(); });
    raiz.addEventListener('pointerleave', () => { sobre = false; agendar(); });
    raiz.addEventListener('focusin', () => { sobre = true; agendar(); });
    raiz.addEventListener('focusout', () => { sobre = false; agendar(); });
    raiz.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { mostrar(atual - 1); agendar(); }
      if (e.key === 'ArrowRight') { mostrar(atual + 1); agendar(); }
    });
    document.addEventListener('visibilitychange', agendar);

    mostrar(0);
    atualizarPausa();
  }
</script>
