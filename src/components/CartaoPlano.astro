---
import { cidades } from '@/data';

interface Props {
  plano: {
    id: string;
    nome: string;
    preco: string;
    novo: boolean;
    itens: { texto: string; dica?: string }[];
  };
  /** Com botão de compra (página de planos) ou só o resumo (página de inscrição) */
  comprar?: boolean;
  /** Formulário ao qual o seletor de cidade pertence (atributo form) */
  form?: string;
  idSelect: string;
}
const { plano, comprar = false, form, idSelect } = Astro.props;
---

<div class="rounded-xl bg-card p-6 sombra-suave border border-border" data-cartao-plano={plano.id}>
  <h2 class="flex items-center gap-3 text-2xl font-semibold">
    {plano.nome}
    {plano.novo && <span class="rounded-md bg-sucesso px-2 py-0.5 text-xs font-semibold text-sucesso-foreground">Novo</span>}
  </h2>
  <ul class="lista-plano mt-3">
    {
      plano.itens.map((i) => (
        <li>
          <span aria-hidden="true" class="text-primary">→ </span>{i.texto}
          {i.dica && <span class="mt-0.5 block text-sm text-muted-foreground">{i.dica}</span>}
        </li>
      ))
    }
  </ul>
  <div class="mt-3">
    <label for={idSelect} class="campo-rotulo">Cidade</label>
    <select
      id={idSelect}
      name={comprar ? undefined : 'cidade'}
      class="campo-entrada"
      required={!comprar}
      form={form}
      data-erro-de="a cidade"
      data-tipo="selecao"
      aria-describedby={comprar ? undefined : `${idSelect}-erro`}
      data-select-cidade={comprar ? plano.id : undefined}
    >
      <option value="">Selecione a cidade</option>
      {cidades.map((c) => <option value={c}>{c}</option>)}
    </select>
    {!comprar && <p id={`${idSelect}-erro`} class="mensagem-erro" data-visivel="false"></p>}
  </div>
  <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
    {
      comprar && (
        <a
          href={`/inscricao/?plano=${plano.id}`}
          class="press botao-primario inline-flex min-h-12 flex-1 items-center justify-center rounded-lg px-6 text-lg font-medium"
          data-link-compra={plano.id}>Comprar plano</a>
      )
    }
    <span class="text-2xl font-semibold">{plano.preco}</span>
  </div>
</div>
