---
import Layout from '@/layouts/Layout.astro';
import Campo from '@/components/Campo.astro';
import CartaoPlano from '@/components/CartaoPlano.astro';
import { planos } from '@/data';

const estados = ['Rio de Janeiro', 'São Paulo', 'Paraná', 'Ceará', 'Acre'];
const meses = Array.from({ length: 12 }, (_, i) => String(i + 1).padStart(2, '0'));
const anos = Array.from({ length: 12 }, (_, i) => String(2026 + i));
---

<Layout
  title="Inscreva-se | Caravan"
  description="Formulário de inscrição do Caravan, só de demonstração: a validação roda no navegador e nada é enviado."
  atual="/inscricao/"
>
  <section class="mx-auto max-w-6xl px-4 sm:px-6" aria-labelledby="titulo-inscricao">
    <div class="my-12 text-center" data-reveal>
      <p class="rotulo-topo">Programe a viagem do seu sonho</p>
      <h1 id="titulo-inscricao" class="titulo-pagina mt-2 text-primary">Inscreva-se</h1>
    </div>

    <p class="mx-auto mb-8 max-w-3xl rounded-lg border border-border bg-card px-4 py-3 text-center text-sm text-muted-foreground">
      Demonstração: não digite dados reais. Os campos são validados no navegador e nada é enviado nem guardado.
    </p>

    <div class="grid gap-10 lg:grid-cols-12">
      <form
        id="form-inscricao"
        method="dialog"
        data-demo-form
        data-demo-titulo="Inscrição de demonstração"
        data-demo-msg="Plano simulado: nada foi enviado, cobrado ou guardado. Este é um site de estudo."
        class="lg:col-span-7"
        aria-label="Formulário de inscrição"
      >
        <div class="grid gap-x-4 gap-y-4 md:grid-cols-2">
          <Campo id="inscricao-nome" name="nome" rotulo="Nome" erroDe="o nome completo" regra="nome" placeholder="Nome completo" autocomplete="off" />
          <Campo id="inscricao-cpf" name="cpf" rotulo="CPF" erroDe="o CPF" regra="cpf" placeholder="000.000.000-00" inputmode="numeric" autocomplete="off" maxlength={14} />
          <Campo id="inscricao-email" name="email" rotulo="E-mail" erroDe="o e-mail" tipo="email" regra="email" placeholder="Seu e-mail" autocomplete="off" />
          <Campo id="inscricao-senha" name="senha" rotulo="Senha" erroDe="a senha" tipo="password" regra="senha" placeholder="Senha de acesso" autocomplete="new-password" dica="Mínimo de 6 caracteres." />
          <Campo id="inscricao-endereco" name="endereco" rotulo="Endereço" erroDe="o endereço" placeholder="Número, nome da rua e bairro" autocomplete="off" class="md:col-span-2" />
          <Campo id="inscricao-cidade" name="cidade-endereco" rotulo="Cidade" erroDe="a cidade" autocomplete="off" />
          <div class="grid grid-cols-2 gap-4">
            <Campo id="inscricao-estado" name="estado" rotulo="Estado" erroDe="o estado" tipo="select" opcoes={estados} opcaoVazia="Selecione" />
            <Campo id="inscricao-cep" name="cep" rotulo="CEP" erroDe="o CEP" regra="cep" placeholder="00000-000" inputmode="numeric" autocomplete="off" maxlength={9} />
          </div>
        </div>

        <fieldset class="mt-8 rounded-xl border border-border bg-card p-4 sm:p-5" data-grupo-pagamento>
          <legend class="rotulo-topo px-2 !text-primary">Forma de pagamento</legend>
          <div class="grid grid-cols-2 gap-2">
            <label class="opcao-pagamento">
              <input type="radio" name="pagamento" value="cartao" checked />
              <span>Cartão de crédito</span>
            </label>
            <label class="opcao-pagamento">
              <input type="radio" name="pagamento" value="boleto" />
              <span>Boleto bancário</span>
            </label>
          </div>

          <div class="mt-5" data-painel="cartao">
            <p class="mb-3 text-sm text-muted-foreground">Não use um cartão real: os dados nunca saem desta página.</p>
            <div class="grid gap-x-4 gap-y-4 md:grid-cols-2">
              <Campo id="cartao-nome" name="nome-cartao" rotulo="Nome no cartão" erroDe="o nome no cartão" placeholder="Nome impresso no cartão" autocomplete="off" class="md:col-span-2" />
              <Campo id="cartao-numero" name="numero-cartao" rotulo="Número do cartão" erroDe="o número do cartão" regra="cartao" placeholder="5555 5555 5555 5555" inputmode="numeric" autocomplete="off" maxlength={23} />
              <Campo id="cartao-codigo" name="codigo-cartao" rotulo="Código de segurança" erroDe="o código de segurança" regra="cvv" placeholder="000" inputmode="numeric" autocomplete="off" maxlength={4} />
              <Campo id="cartao-mes" name="mes" rotulo="Mês" erroDe="o mês" tipo="select" opcoes={meses} opcaoVazia="Mês" />
              <Campo id="cartao-ano" name="ano" rotulo="Ano" erroDe="o ano" tipo="select" opcoes={anos} opcaoVazia="Ano" />
            </div>
          </div>
          <div class="mt-5" data-painel="boleto" hidden={false}>
            <p class="text-lg">Clique em contratar plano que enviaremos um boleto para o seu e-mail.</p>
            <p class="mt-1 text-sm text-muted-foreground">Demonstração: nenhum boleto será gerado.</p>
          </div>
        </fieldset>

        <div class="mt-6">
          <label class="flex min-h-11 items-center gap-3">
            <input
              id="inscricao-termos"
              name="termos"
              type="checkbox"
              required
              class="size-5 shrink-0 accent-[var(--primary)]"
              data-erro="Aceite os termos e condições para continuar."
              aria-describedby="inscricao-termos-erro"
            />
            <span>Concordo com os termos e condições (de exemplo).</span>
          </label>
          <p id="inscricao-termos-erro" class="mensagem-erro" data-visivel="false"></p>
        </div>

        <p class="resumo-erro mt-2" role="alert" data-resumo></p>
        <button type="submit" class="press botao-primario mt-3 inline-flex min-h-12 items-center rounded-lg px-7 text-lg font-medium">Contratar plano</button>
      </form>

      <aside class="order-first lg:order-none lg:col-span-5" aria-labelledby="plano-escolhido">
        <p id="plano-escolhido" class="rotulo-topo mb-3 !text-primary">Plano escolhido</p>
        <div data-plano-wrap="gold"><CartaoPlano plano={planos.gold} form="form-inscricao" idSelect="inscricao-cidade-gold" /></div>
        <div data-plano-wrap="platinum" hidden><CartaoPlano plano={planos.platinum} form="form-inscricao" idSelect="inscricao-cidade-platinum" /></div>
      </aside>
    </div>
  </section>
</Layout>

<script>
  // O plano e a cidade escolhidos em /planos/ chegam pela URL (?plano=platinum&cidade=Paris).
  const parametros = new URLSearchParams(location.search);
  const plano = parametros.get('plano') === 'platinum' ? 'platinum' : 'gold';
  const cidade = parametros.get('cidade') ?? '';
  document.querySelectorAll<HTMLElement>('[data-plano-wrap]').forEach((wrap) => {
    const ativo = wrap.dataset.planoWrap === plano;
    wrap.hidden = !ativo;
    const sel = wrap.querySelector<HTMLSelectElement>('select');
    if (sel) {
      sel.disabled = !ativo;
      if (ativo && cidade && [...sel.options].some((o) => o.value === cidade)) sel.value = cidade;
    }
  });
</script>
