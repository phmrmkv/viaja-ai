---
import Layout from '@/layouts/Layout.astro';
import Campo from '@/components/Campo.astro';
import Perguntas from '@/components/Perguntas.astro';
import { contato } from '@/data';
---

<Layout
  title="Fale conosco | Caravan"
  description="Fale com a Caravan: formulário de contato, endereço e perguntas frequentes. Contatos fictícios, site de demonstração."
  atual="/contato/"
>
  <section class="mx-auto max-w-6xl px-4 sm:px-6" aria-labelledby="titulo-contato">
    <div class="my-12 text-center" data-reveal>
      <p class="rotulo-topo">Possui alguma dúvida?</p>
      <h1 id="titulo-contato" class="titulo-pagina mt-2 text-primary">Fale conosco</h1>
    </div>
    <div class="grid gap-10 lg:grid-cols-2">
      <div data-reveal>
        <form
          method="dialog"
          data-demo-form
          data-demo-titulo="Mensagem de demonstração"
          data-demo-msg="Mensagem simulada: nada foi enviado e nenhum dado foi guardado. Este é um site de estudo."
          class="grid gap-4 rounded-xl border border-border bg-card p-5 sombra-suave sm:p-6"
          aria-label="Formulário de contato"
        >
          <Campo id="contato-nome" name="nome" rotulo="Nome" erroDe="o nome" autocomplete="off" />
          <Campo id="contato-email" name="email" rotulo="E-mail" erroDe="o e-mail" tipo="email" regra="email" autocomplete="off" />
          <Campo id="contato-mensagem" name="mensagem" rotulo="Mensagem" erroDe="a mensagem" tipo="textarea" linhas={4} />
          <p class="resumo-erro" role="alert" data-resumo></p>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
            <button type="submit" class="press botao-primario inline-flex min-h-12 items-center rounded-lg px-6 text-lg font-medium">Enviar mensagem</button>
            <p class="text-sm text-muted-foreground">Demonstração: nada é enviado.</p>
          </div>
        </form>
      </div>

      <div data-reveal style="--i: 1">
        <h2 class="rotulo-topo">Nosso endereço</h2>
        <p class="mt-3 mb-6 text-muted-foreground">{contato.endereco} <span class="text-sm">(endereço fictício)</span></p>
        <h2 class="rotulo-topo">Dados de contato</h2>
        <ul class="mt-3 mb-2 space-y-1 text-muted-foreground">
          <li>{contato.email}</li>
          <li>{contato.telefone}</li>
          <li>{contato.horario}</li>
        </ul>
        <p class="mb-6 inline-block rounded-md border border-border px-2.5 py-1 text-sm text-muted-foreground">
          Demonstração: {contato.aviso}
        </p>
        <h2 class="rotulo-topo">Redes sociais</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            ['Facebook', 'Twitter', 'Youtube'].map((r) => (
              <li>
                <button
                  type="button"
                  class="press botao-contorno-neutro inline-flex min-h-11 min-w-32 items-center justify-center rounded-lg px-4 text-sm"
                  data-demo
                  data-demo-titulo="Rede social de demonstração"
                  data-demo-msg={`O perfil no ${r} é fictício: este é um site de estudo e não há página real.`}>{r}</button>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <div class="pt-8">
    <Perguntas />
  </div>
</Layout>
