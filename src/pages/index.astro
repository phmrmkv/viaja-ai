---
import { Picture } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import Carrossel from '@/components/Carrossel.astro';
import Campo from '@/components/Campo.astro';
import Vantagem from '@/components/Vantagem.astro';
import Perguntas from '@/components/Perguntas.astro';
import fundoCitacao from '@/assets/bg-quote.jpg';
import { vantagens } from '@/data';
---

<Layout
  title="Caravan | Realize a viagem do seu sonho"
  description="Caravan: site demonstrativo de viagens com planos para a Califórnia, Paris e Dublin. Projeto de estudo, sem vendas reais."
  atual="/"
>
  <section class="bg-faixa text-faixa-foreground na-faixa" aria-labelledby="titulo-hero">
    <div class="mx-auto grid max-w-[90rem] lg:grid-cols-12">
      <div class="lg:col-span-7">
        <Carrossel />
      </div>
      <div class="flex flex-col justify-center gap-5 px-4 py-10 sm:px-8 lg:col-span-5 lg:px-10">
        <h1 id="titulo-hero" class="titulo-hero">Realize a viagem do seu sonho</h1>
        <p class="text-lg text-faixa-muted sm:text-xl">O melhor local para viajar é com a Caravan, mais de 5.000 excursões concluídas.</p>
        <form
          method="dialog"
          data-demo-form
          data-demo-titulo="Inscrição de demonstração"
          data-demo-msg="Este é um site de estudo: nada foi enviado e nenhum e-mail foi guardado."
          class="flex flex-col gap-2"
          aria-label="Inscreva-se com seu e-mail"
        >
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start">
            <Campo
              id="hero-email"
              name="email"
              rotulo="E-mail"
              erroDe="o e-mail"
              tipo="email"
              regra="email"
              autocomplete="off"
              placeholder="Seu e-mail"
              class="flex-1 [&_.campo-rotulo]:sr-only [&_.campo-entrada]:min-h-12 [&_.campo-entrada]:bg-white [&_.campo-entrada]:text-[#212529] [&_.campo-entrada::placeholder]:text-[#5c636a]"
            />
            <button type="submit" class="press botao-primario inline-flex min-h-12 items-center justify-center rounded-lg px-6 text-lg font-medium">Inscreva-se</button>
          </div>
          <p class="resumo-erro !text-faixa-erro" role="alert" data-resumo></p>
          <p class="text-sm text-faixa-muted">Demonstração: nada é enviado.</p>
        </form>
      </div>
    </div>
  </section>

  <section class="bg-card py-16 sm:py-20" aria-labelledby="titulo-vantagens">
    <div class="mx-auto max-w-6xl px-4 text-center sm:px-6">
      <div data-reveal>
        <p class="rotulo-topo">Tudo de melhor para você</p>
        <h2 id="titulo-vantagens" class="titulo-pagina mt-2 text-primary">Aproveite as vantagens</h2>
      </div>
      <div class="mt-12 grid gap-x-8 gap-y-12 sm:grid-cols-2 xl:grid-cols-3">
        {
          vantagens.map((v, i) => (
            <div data-reveal style={`--i: ${i % 3}`}>
              <Vantagem {...v} />
            </div>
          ))
        }
      </div>
      <a href="/planos/" class="press botao-primario mt-14 inline-flex min-h-12 items-center rounded-lg px-7 text-lg font-medium">Comprar plano</a>
    </div>
  </section>

  <section class="relative isolate overflow-hidden" aria-label="Citação">
    <Picture
      src={fundoCitacao}
      alt=""
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[800, 1280, 2000]}
      sizes="100vw"
      quality={60}
      loading="lazy"
      class="absolute inset-0 -z-20 h-full w-full object-cover"
      pictureAttributes={{ class: 'contents' }}
    />
    <div class="absolute inset-0 -z-10 bg-black/60" aria-hidden="true"></div>
    <blockquote class="mx-auto max-w-4xl px-4 py-16 text-center text-white sm:px-6 sm:py-24" data-reveal>
      <p class="text-2xl font-light italic leading-snug sm:text-4xl">
        “A felicidade não está na estrada que leva a algum lugar. A felicidade é a própria estrada.”
      </p>
      <footer class="mt-6 text-white/90">— Bob Dylan</footer>
    </blockquote>
  </section>

  <div class="pt-4">
    <Perguntas />
  </div>
</Layout>
