---
import Base from '@/layouts/Base.astro';
import Cabecalho from '@/components/Cabecalho.astro';
import Rodape from '@/components/Rodape.astro';
import Demo from '@/components/Demo.astro';
import Dialogos from '@/components/Dialogos.astro';

const passos = [
  {
    titulo: 'Conte a viagem',
    texto: 'Destino, datas, quanto pode gastar e o jeito que você gosta de viajar: mais calma, mais passeio, mais comida.',
  },
  {
    titulo: 'Receba o roteiro',
    texto: 'A IA monta o plano dia a dia, com manhã, tarde e noite, e sugere onde ficar e o que levar na mala.',
  },
  {
    titulo: 'Ajuste conversando',
    texto: 'Choveu, o voo atrasou, o orçamento apertou? Diga o que mudou e o plano se refaz sem você começar do zero.',
  },
];

const icones = {
  calendario: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
  cama: '<path d="M2 4v16M2 8h18a2 2 0 0 1 2 2v10M2 17h20M6 8v9"/>',
  mala: '<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>',
  refazer: '<path d="M3 12a9 9 0 0 1 15-6.7L21 8M21 3v5h-5M21 12a9 9 0 0 1-15 6.7L3 16M3 21v-5h5"/>',
  carteira: '<path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/>',
};

const recursos = [
  { icone: icones.calendario, titulo: 'Roteiro dia a dia', texto: 'Organiza cada dia em manhã, tarde e noite, com os deslocamentos pensados para não ficar correndo.' },
  { icone: icones.cama, titulo: 'Sugestão de onde ficar', texto: 'Indica regiões da cidade que combinam com o seu roteiro e com o seu jeito de viajar.' },
  { icone: icones.mala, titulo: 'Lista do que levar', texto: 'Monta a lista da mala conforme o clima, os dias e o que você vai fazer em cada um.' },
  { icone: icones.refazer, titulo: 'Plano que se ajusta', texto: 'Quando algo muda, refaz só o que precisa e mantém o resto do plano no lugar.' },
  { icone: icones.carteira, titulo: 'Olho no orçamento', texto: 'Usa o valor que você informou como limite para escolher passeios, refeições e hospedagem.' },
];

const perguntas = [
  { p: 'A Viaja.ai já funciona?', r: 'Ainda não. O produto está em desenvolvimento e esta página é uma demonstração. Os botões não levam a nenhum serviço em uso.' },
  { p: 'Ela vai reservar voos e hotéis?', r: 'A ideia é planejar e sugerir. A reserva fica com você, nos sites que escolher. O que o produto fará ou não ainda pode mudar durante o desenvolvimento.' },
  { p: 'E se eu não gostar do plano?', r: 'Você pede o ajuste em uma frase: trocar um dia, gastar menos, andar menos. A IA refaz a parte pedida.' },
  { p: 'Os roteiros estarão sempre certos?', r: 'Não. Como qualquer assistente com IA, ela pode errar horário, preço ou se um lugar está aberto. A proposta é apontar o que vale conferir antes de sair.' },
  { p: 'Quanto vai custar?', r: 'Ainda não foi definido. Hoje não existe plano pago nem cobrança de nenhum tipo.' },
  { p: 'O que acontece com o e-mail que eu digitar?', r: 'Nesta demonstração, nada: o formulário não envia nem guarda nenhum dado.' },
];
---

<Base
  title="Viaja.ai: roteiros de viagem feitos por IA (em desenvolvimento)"
  description="A Viaja.ai é um assistente com IA que monta o roteiro da sua viagem dia a dia, sugere onde ficar e o que levar, e ajusta o plano quando algo muda. Produto em desenvolvimento; esta página é uma demonstração."
>
  <Cabecalho slot="topo" />

  <section class="hero" id="inicio" aria-labelledby="titulo-hero">
    <div class="miolo hero-grade">
      <div>
        <h1 id="titulo-hero">Diga para onde. A Viaja.ai monta o roteiro.</h1>
        <p class="hero-texto">
          Você conta o destino, as datas, o orçamento e o estilo da viagem. A IA monta o plano dia a dia, sugere onde ficar e o que levar, e refaz o que for preciso quando algo muda.
        </p>
        <div class="hero-acoes">
          <button type="button" class="btn btn-primario" data-abrir="dlg-aviso">Começar a planejar</button>
          <a class="btn btn-secundario" href="#como-funciona">Ver como funciona</a>
        </div>
      </div>
      <Demo />
    </div>
  </section>

  <section class="secao" id="como-funciona" aria-labelledby="titulo-como">
    <div class="miolo passos-grade">
      <div data-reveal>
        <h2 class="titulo-secao" id="titulo-como">Do pedido ao roteiro em três passos</h2>
        <p class="texto-secao">Você descreve a viagem como contaria a um amigo. O resto é com a IA, e você decide o que fica.</p>
      </div>
      <ol class="passos">
        {passos.map((p, i) => (
          <li class="passo" data-reveal style={`--i: ${i}`}>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="secao fundo-faixa" id="o-que-faz" aria-labelledby="titulo-faz">
    <div class="miolo">
      <div data-reveal>
        <h2 class="titulo-secao" id="titulo-faz">O que a IA faz por você</h2>
        <p class="texto-secao">O que está previsto para o produto. Algumas partes ainda estão sendo construídas.</p>
      </div>
      <div class="recursos">
        {recursos.map((r, i) => (
          <div class="recurso" data-reveal style={`--i: ${i % 2}`}>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={r.icone} />
            <div>
              <h3>{r.titulo}</h3>
              <p>{r.texto}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="secao" id="perguntas" aria-labelledby="titulo-perguntas">
    <div class="miolo">
      <h2 class="titulo-secao" id="titulo-perguntas" data-reveal>Perguntas frequentes</h2>
      <div class="perguntas" data-reveal>
        {perguntas.map((q) => (
          <details class="pergunta">
            <summary>
              {q.p}
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div class="pergunta-resposta"><p>{q.r}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="miolo" aria-labelledby="titulo-chamada">
    <div class="chamada" data-reveal>
      <h2 id="titulo-chamada">Quer saber quando abrir?</h2>
      <p>A lista de espera ainda é parte da demonstração: o formulário não envia nem guarda nada.</p>
      <button type="button" class="btn btn-primario" data-abrir="dlg-lista">Entrar na lista de espera</button>
    </div>
  </section>

  <Rodape slot="rodape" />
  <Dialogos />
</Base>
