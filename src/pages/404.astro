---
import Base from '@/layouts/Base.astro';
import Cabecalho from '@/components/Cabecalho.astro';
import Rodape from '@/components/Rodape.astro';
---

<Base title="Página não encontrada | Viaja.ai" description="Esta página não existe na demonstração da Viaja.ai." noindex>
  <Cabecalho slot="topo" base="/" />
  <section class="miolo pagina-erro" aria-labelledby="titulo-erro">
    <div>
      <h1 id="titulo-erro">Esse trajeto não leva a lugar nenhum</h1>
      <p class="texto-secao">A página que você procurou não existe ou mudou de endereço. Volte ao início e recomece o roteiro.</p>
      <p style="margin-top: 1.5rem"><a class="btn btn-primario" href="/">Voltar ao início</a></p>
    </div>
  </section>
  <Rodape slot="rodape" />
</Base>
