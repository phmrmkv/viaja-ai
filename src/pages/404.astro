---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Página não encontrada | Caravan" description="Esta página não existe no site de demonstração do Caravan." atual="" noindex>
  <section class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6" aria-labelledby="titulo-404">
    <p class="rotulo-topo">Erro 404</p>
    <h1 id="titulo-404" class="titulo-pagina mt-2 text-primary">Página não encontrada</h1>
    <p class="mt-4 text-lg text-muted-foreground">O endereço que você abriu não existe. Volte para o início e escolha o próximo destino.</p>
    <a href="/" class="press botao-primario mt-8 inline-flex min-h-12 items-center rounded-lg px-7 text-lg font-medium">Voltar ao início</a>
  </section>
</Layout>
